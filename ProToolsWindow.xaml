<Window x:Class="EsoAddons.ProToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shoyru Addon Suite — Pro Tools"
        Width="640" Height="720" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- Snapshot row template (shared by profiles + backups) -->
        <DataTemplate x:Key="SnapshotRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Apply" Style="{StaticResource Update}" Padding="10,3" Margin="0,0,6,0" Click="ApplySnapshot_Click"/>
                    <Button Content="Delete" Style="{StaticResource Ghost}" Padding="10,3" Click="DeleteSnapshot_Click"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Pro Tools" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
            <TextBlock Text="Profiles, backups and multi-PC sync save your installed-addon list and your in-game settings (SavedVariables) together. Close ESO before restoring, so it doesn't overwrite the restored configs on exit."
                       Style="{StaticResource SectionHint}" Margin="0,2,0,0"/>
            <!-- shared apply options -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox x:Name="RestoreConfigsCheck" Content="Restore in-game settings" IsChecked="True"
                          Foreground="{DynamicResource Text}" Margin="0,0,18,0"
                          ToolTip="When applying a profile/backup/sync, also restore the saved SavedVariables configs"/>
                <CheckBox x:Name="RemoveExtrasCheck" Content="Remove addons not in the snapshot" IsChecked="False"
                          Foreground="{DynamicResource Text}"
                          ToolTip="Make this PC match the snapshot exactly by removing managed addons that aren't in it"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Auto-update on launch -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Auto-update on launch" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Keep every addon current automatically — the app updates anything out of date each time it starts." Style="{StaticResource SectionHint}"/>
                        <CheckBox Content="Update all addons automatically when the app launches"
                                  IsChecked="{Binding AutoUpdateOnLaunch}" Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                </Border>

                <!-- Profiles -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Profiles / loadouts" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Save a named set of addons + settings you can switch between (e.g. “PvP” and “PvE”)." Style="{StaticResource SectionHint}"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Save profile" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="SaveProfile_Click"/>
                            <TextBox x:Name="ProfileNameBox" ToolTip="Name for the new profile"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Profiles}" ItemTemplate="{StaticResource SnapshotRow}"
                                 HorizontalContentAlignment="Stretch" MaxHeight="170" BorderThickness="0" Background="Transparent"/>
                        <TextBlock Text="No profiles saved yet." Style="{StaticResource SectionHint}" Margin="2,6,0,0"
                                   Visibility="{Binding Profiles.Count, Converter={StaticResource CountToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Backups -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Backups" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Timestamped local snapshots of your addons + settings. Restore one anytime if something breaks." Style="{StaticResource SectionHint}"/>
                        <Button Content="Back up now" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="BackupNow_Click"/>
                        <ListBox ItemsSource="{Binding Backups}" ItemTemplate="{StaticResource SnapshotRow}"
                                 HorizontalContentAlignment="Stretch" MaxHeight="170" BorderThickness="0" Background="Transparent"/>
                        <TextBlock Text="No backups yet." Style="{StaticResource SectionHint}" Margin="2,6,0,0"
                                   Visibility="{Binding Backups.Count, Converter={StaticResource CountToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Multi-PC sync -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Multi-PC sync" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Pick a folder inside a cloud drive you already use (OneDrive, Dropbox, Google Drive…). Push from one PC, pull on another — your addons + settings follow you."
                                   Style="{StaticResource SectionHint}"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Choose folder…" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="ChooseSyncFolder_Click"/>
                            <Border Background="{DynamicResource PanelAlt}" CornerRadius="4" Padding="8,5">
                                <TextBlock Text="{Binding SyncFolder, TargetNullValue='(no folder set)'}" Foreground="{DynamicResource Muted}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding SyncFolder}"/>
                            </Border>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Push to sync" Style="{StaticResource Primary}" Margin="0,0,8,0" Click="SyncPush_Click"
                                    IsEnabled="{Binding HasSyncFolder}" ToolTip="Upload this PC's addons + settings to the sync folder"/>
                            <Button Content="Pull from sync" Style="{StaticResource Update}" Click="SyncPull_Click"
                                    IsEnabled="{Binding HasSyncFolder}" ToolTip="Apply the synced addons + settings to this PC"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource Ghost}" IsCancel="True" Click="Close_Click"/>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
