<Window x:Class="EsoAddons.ProToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EsoAddons.Services"
        Title="Shoyru's Addon Suite — Pro Tools"
        Width="640" Height="720" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- Snapshot row template (shared by profiles + backups) -->
        <DataTemplate x:Key="SnapshotRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Tr PT_Apply}" Style="{StaticResource Update}" Padding="10,3" Margin="0,0,6,0" Click="ApplySnapshot_Click"/>
                    <Button Content="{loc:Tr PT_Delete}" Style="{StaticResource Ghost}" Padding="10,3" Click="DeleteSnapshot_Click"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{loc:Tr PT_Heading}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
            <TextBlock Text="{loc:Tr PT_Intro}"
                       Style="{StaticResource SectionHint}" Margin="0,2,0,0"/>
            <!-- shared apply options -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox x:Name="RestoreConfigsCheck" Content="{loc:Tr PT_RestoreConfigs}" IsChecked="True"
                          Foreground="{DynamicResource Text}" Margin="0,0,18,0"
                          ToolTip="{loc:Tr PT_RestoreConfigsTip}"/>
                <CheckBox x:Name="RemoveExtrasCheck" Content="{loc:Tr PT_ExactMatch}" IsChecked="False"
                          Foreground="{DynamicResource Text}"
                          ToolTip="{loc:Tr PT_ExactMatchTip}"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Auto-update on launch -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr PT_AutoUpdateTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{loc:Tr PT_AutoUpdateHint}" Style="{StaticResource SectionHint}"/>
                        <CheckBox Content="{loc:Tr PT_AutoUpdateCheck}"
                                  IsChecked="{Binding AutoUpdateOnLaunch}" Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                </Border>

                <!-- Profiles -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr PT_ProfilesTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{loc:Tr PT_ProfilesHint}" Style="{StaticResource SectionHint}"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="{loc:Tr PT_SaveProfile}" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="SaveProfile_Click"/>
                            <TextBox x:Name="ProfileNameBox" ToolTip="{loc:Tr PT_ProfileNameTip}"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Profiles}" ItemTemplate="{StaticResource SnapshotRow}"
                                 HorizontalContentAlignment="Stretch" MaxHeight="170" BorderThickness="0" Background="Transparent"/>
                        <TextBlock Text="{loc:Tr PT_NoProfiles}" Style="{StaticResource SectionHint}" Margin="2,6,0,0"
                                   Visibility="{Binding Profiles.Count, Converter={StaticResource CountToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Backups -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr PT_BackupsTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{loc:Tr PT_BackupsHint}" Style="{StaticResource SectionHint}"/>
                        <Button Content="{loc:Tr PT_BackupNow}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="BackupNow_Click"/>
                        <ListBox ItemsSource="{Binding Backups}" ItemTemplate="{StaticResource SnapshotRow}"
                                 HorizontalContentAlignment="Stretch" MaxHeight="170" BorderThickness="0" Background="Transparent"/>
                        <TextBlock Text="{loc:Tr PT_NoBackups}" Style="{StaticResource SectionHint}" Margin="2,6,0,0"
                                   Visibility="{Binding Backups.Count, Converter={StaticResource CountToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Multi-PC sync -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr PT_SyncTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{loc:Tr PT_SyncHint}"
                                   Style="{StaticResource SectionHint}"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="{loc:Tr PT_ChooseFolder}" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="ChooseSyncFolder_Click"/>
                            <Border Background="{DynamicResource PanelAlt}" CornerRadius="4" Padding="8,5">
                                <TextBlock Text="{Binding SyncFolder, TargetNullValue='(no folder set)'}" Foreground="{DynamicResource Muted}"
                                           FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding SyncFolder}"/>
                            </Border>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Tr PT_PushSync}" Style="{StaticResource Primary}" Margin="0,0,8,0" Click="SyncPush_Click"
                                    IsEnabled="{Binding HasSyncFolder}" ToolTip="{loc:Tr PT_PushSyncTip}"/>
                            <Button Content="{loc:Tr PT_PullSync}" Style="{StaticResource Update}" Click="SyncPull_Click"
                                    IsEnabled="{Binding HasSyncFolder}" ToolTip="{loc:Tr PT_PullSyncTip}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{loc:Tr PT_Close}" Style="{StaticResource Ghost}" IsCancel="True" Click="Close_Click"/>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
