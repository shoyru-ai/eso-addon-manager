<Window x:Class="EsoAddons.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:EsoAddons.Behaviors"
        Title="{Binding AppVersion, StringFormat='Shoyru''s ESO Addons {0}'}" Height="760" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Segmented filter button -->
        <Style x:Key="FilterAll" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="14,5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAll}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterAddons" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="14,5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAddons}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterLibs" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="14,5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLibraries}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SortDownloads" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSortDownloads}" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SortRecent" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSortRecent}" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SortName" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSortName}" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            </DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- App update banner -->
        <Border Grid.Row="0" Background="{StaticResource Accent}" Padding="14,8"
                Visibility="{Binding AppUpdateAvailable, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="What's New" Style="{StaticResource Ghost}" Click="WhatsNew_Click" Margin="0,0,8,0"/>
                    <Button Content="Update now" Style="{StaticResource Update}" Click="UpdateNow_Click"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"><Run Text="A new version of Shoyru's ESO Addons (v"/><Run Text="{Binding AppUpdateVersion}"/><Run Text=") is available."/></TextBlock>
            </DockPanel>
        </Border>

        <!-- Header -->
        <Grid Grid.Row="1" Margin="18,16,18,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Shoyru's ESO Addons" FontSize="22" FontWeight="Bold"/>
                <Border Background="{StaticResource PanelAlt}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold"
                               ToolTip="Running version"/>
                </Border>
                <TextBlock Text="{Binding AddonsPath}" Foreground="{StaticResource Muted}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Change folder…" Style="{StaticResource Ghost}" Click="ChangeFolder_Click" Margin="0,0,8,0"/>
                <Button Content="Open AddOns Folder" Style="{StaticResource Ghost}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"/>
                <Button Content="Refresh" Style="{StaticResource Primary}" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Filter -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="18,2,18,8">
            <TextBlock Text="Show:" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
            <Button Content="All" Style="{StaticResource FilterAll}" Command="{Binding SetFilterCommand}" CommandParameter="All" Margin="0,0,6,0"/>
            <Button Content="Addons" Style="{StaticResource FilterAddons}" Command="{Binding SetFilterCommand}" CommandParameter="Addons" Margin="0,0,6,0"/>
            <Button Content="Libraries" Style="{StaticResource FilterLibs}" Command="{Binding SetFilterCommand}" CommandParameter="Libraries"/>
        </StackPanel>

        <!-- Content: list + detail -->
        <Grid Grid.Row="3" Margin="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="390" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- LISTS -->
            <TabControl x:Name="MainTabs" Grid.Column="0" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
                <!-- Installed -->
                <TabItem Header="Installed">
                    <Grid Background="{StaticResource Panel}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#33B4544E" BorderBrush="{StaticResource Danger}" BorderThickness="1" CornerRadius="6" Margin="12,12,12,0"
                                Visibility="{Binding AddonsFolderFound, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Margin="10,8" TextWrapping="Wrap" Foreground="{StaticResource Text}"
                                       Text="Couldn't find your ESO AddOns folder. Click 'Change folder…' (top-right) and select your  …\Elder Scrolls Online\live\AddOns  folder."/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="12,12,12,8">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Search:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                <TextBox Text="{Binding InstalledSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Filter your installed addons by name, author, or folder"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UpdateSummary}" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Button Content="Update All" Style="{StaticResource Update}" Command="{Binding UpdateAllCommand}" Margin="14,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding InstalledView}" SelectedItem="{Binding SelectedInstalled}" Margin="6,0,6,6">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="44" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Width="26" Height="26" b:ImageLoader.SourceUrl="{Binding ThumbUrl}" Stretch="Uniform"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Addon" Binding="{Binding Title}" Width="2*"/>
                                <DataGridTextColumn Header="Installed" Binding="{Binding DisplayVersion}" Width="*"/>
                                <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="*"/>
                                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="170" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,8,0"/>
                                                <Button Content="Update" Style="{StaticResource Update}" Padding="10,4" Margin="0,0,6,0"
                                                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Remove" Style="{StaticResource Ghost}" Padding="10,4"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Browse -->
                <TabItem Header="Browse ESOUI">
                    <Grid Background="{StaticResource Panel}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" MinWidth="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- category sidebar -->
                        <DockPanel Grid.Column="0" Margin="8,12,4,8">
                            <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,6"/>
                            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- drag to resize the category panel -->
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                      Background="{StaticResource Border}" ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Columns" Cursor="SizeWE"/>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="6,12,12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Content="Search" Style="{StaticResource Primary}" Margin="8,0,0,0" Command="{Binding SearchCommand}"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="6,0,12,8">
                                <TextBlock Text="Sort:" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                                <Button Content="Most Downloaded" Style="{StaticResource SortDownloads}" Command="{Binding SetSortCommand}" CommandParameter="Downloads" Margin="0,0,6,0"/>
                                <Button Content="Recently Updated" Style="{StaticResource SortRecent}" Command="{Binding SetSortCommand}" CommandParameter="Recent" Margin="0,0,6,0"/>
                                <Button Content="Name" Style="{StaticResource SortName}" Command="{Binding SetSortCommand}" CommandParameter="Name"/>
                            </StackPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding BrowseView}" SelectedItem="{Binding SelectedBrowse}" Margin="6,0,6,6">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="44" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Width="26" Height="26" b:ImageLoader.SourceUrl="{Binding ThumbUrl}" Stretch="Uniform"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Addon" Binding="{Binding Title}" Width="2*"/>
                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="*"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*"/>
                                <DataGridTextColumn Header="Downloads" Binding="{Binding DownloadsDisplay}" SortMemberPath="Downloads" Width="*"/>
                                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="100" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,8,0"/>
                                                <TextBlock Text="✓ Installed" Foreground="{StaticResource Good}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="Remove" Style="{StaticResource Ghost}" Padding="10,4"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.RemoveBrowseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Install" Style="{StaticResource Primary}" Padding="10,4"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource InvBoolToVis}}"
                                                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Shoyru's published addons -->
                <TabItem x:Name="CustomAddonsTab" Header="Shoyru's Custom Addons">
                    <Grid Background="{StaticResource Panel}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,12,12,8">
                            <TextBlock Text="Addons created by Shoyru — install them directly." Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                            <Button Content="View on GitHub" Style="{StaticResource Ghost}" Command="{Binding OpenMyAddonsRepoCommand}" Margin="14,0,0,0"/>
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding MyAddons}" SelectedItem="{Binding SelectedMyAddon}"
                                 Background="Transparent" BorderThickness="0" Margin="6,0,6,6"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="12,9">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{StaticResource PanelAlt}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{StaticResource UpdateRow}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <Button Content="Install" Style="{StaticResource Primary}" Padding="10,4" Margin="0,0,6,0"
                                                    Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.InstallMyAddonCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Update" Style="{StaticResource Update}" Padding="10,4" Margin="0,0,6,0"
                                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.InstallMyAddonCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Remove" Style="{StaticResource Ghost}" Padding="10,4"
                                                    Visibility="{Binding ShowRemove, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.RemoveMyAddonCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Password gate overlay (covers the tab until unlocked for this session) -->
                        <Border Grid.RowSpan="2" Background="{StaticResource Panel}"
                                Visibility="{Binding CustomAddonsUnlocked, Converter={StaticResource InvBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="20">
                                <TextBlock Text="&#x1F512;" FontSize="40" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="Shoyru's Custom Addons" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,4" Foreground="{StaticResource Text}"/>
                                <TextBlock Text="This tab is password-protected. Enter the access password to view and install Shoyru's custom addons."
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
                                <Button Content="Enter Password" Style="{StaticResource Primary}" HorizontalAlignment="Center" Click="UnlockCustomAddons_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- drag to resize the addon list vs the description panel -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource Border}" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" Cursor="SizeWE"/>

            <!-- DETAIL PANE -->
            <Border Grid.Column="2" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0" Margin="8,0,0,0">
                <Grid>
                    <TextBlock Text="Select an addon to see details." Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasDetail, Converter={StaticResource InvBoolToVis}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14"
                                  Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Border Background="{StaticResource Bg}" CornerRadius="8" Height="150" Margin="0,0,0,12"
                                    Visibility="{Binding HasDetailImage, Converter={StaticResource BoolToVis}}">
                                <Image b:ImageLoader.SourceUrl="{Binding DetailImageUrl}" Stretch="Uniform" Margin="6"/>
                            </Border>
                            <TextBlock Text="{Binding DetailTitle}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DetailMeta}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>

                            <!-- actions -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Install" Style="{StaticResource Primary}" Margin="0,0,6,0"
                                        Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding InstallCommand}" CommandParameter="{Binding DetailInstallTarget}"/>
                                <TextBlock Text="✓ Installed" Foreground="{StaticResource Good}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding BrowseDetailInstalled, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="Remove" Style="{StaticResource Ghost}" Margin="0,0,6,0"
                                        Visibility="{Binding BrowseDetailInstalled, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding RemoveBrowseCommand}" CommandParameter="{Binding DetailInstallTarget}"/>
                                <Button Content="Update" Style="{StaticResource Update}" Margin="0,0,6,0"
                                        Visibility="{Binding DetailUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding UpdateCommand}" CommandParameter="{Binding DetailRemoveTarget}"/>
                                <Button Content="Remove" Style="{StaticResource Ghost}" Margin="0,0,6,0"
                                        Visibility="{Binding ShowManage, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding RemoveCommand}" CommandParameter="{Binding DetailRemoveTarget}"/>
                                <!-- My Addon actions -->
                                <Button Content="Install" Style="{StaticResource Primary}" Margin="0,0,6,0"
                                        Visibility="{Binding MyDetailShowInstall, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding InstallMyAddonCommand}" CommandParameter="{Binding DetailMyAddonTarget}"/>
                                <Button Content="Update" Style="{StaticResource Update}" Margin="0,0,6,0"
                                        Visibility="{Binding MyDetailUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding InstallMyAddonCommand}" CommandParameter="{Binding DetailMyAddonTarget}"/>
                                <Button Content="Remove" Style="{StaticResource Ghost}" Margin="0,0,6,0"
                                        Visibility="{Binding MyDetailShowRemove, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding RemoveMyAddonCommand}" CommandParameter="{Binding DetailMyAddonTarget}"/>
                                <Button Content="ESOUI Page" Style="{StaticResource Ghost}"
                                        Visibility="{Binding HasDetailPage, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding OpenPageCommand}"/>
                            </StackPanel>

                            <!-- dependencies (installed addon/library) -->
                            <StackPanel Visibility="{Binding HasDependencies, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <TextBlock Text="DEPENDENCIES" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding DetailDependencies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" Margin="0,0,8,0" FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Good}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissingOptional}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMissingRequired}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Get" Style="{StaticResource Update}" Padding="10,3" FontSize="11" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.InstallDepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Name}"
                                                        Visibility="{Binding ShowGet, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- dependencies note (browse mode — ESOUI API doesn't expose deps pre-install) -->
                            <StackPanel Visibility="{Binding ShowDepAutoNote, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <TextBlock Text="DEPENDENCIES" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                <TextBlock Text="Any required libraries are detected and installed automatically when you install this addon." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>

                            <!-- what's new / changelog -->
                            <StackPanel Visibility="{Binding HasChangeLog, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <TextBlock Text="WHAT'S NEW" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                <Border Background="{StaticResource Bg}" CornerRadius="6" Padding="10" MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding DetailChangeLog}" TextWrapping="Wrap" Foreground="{StaticResource Text}" FontSize="12" LineHeight="17"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <!-- description -->
                            <TextBlock Text="DESCRIPTION" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding DetailDescription}" TextWrapping="Wrap" Foreground="{StaticResource Text}" LineHeight="18"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="16,8">
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12"/>
                <TextBlock Text="Working…" Foreground="{StaticResource Accent}" FontSize="12" HorizontalAlignment="Right"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
