<Window x:Class="EsoAddons.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:EsoAddons.Behaviors"
        xmlns:mvvm="clr-namespace:EsoAddons.Mvvm"
        xmlns:loc="clr-namespace:EsoAddons.Services"
        Title="{Binding AppVersion, StringFormat='Shoyru\'s Addon Suite {0}'}" Height="760" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <mvvm:BindingProxy x:Key="VmProxy" Data="{Binding}"/>
        <!-- Segmented filter button -->
        <Style x:Key="FilterAll" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="14,5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAll}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterAddons" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="14,5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAddons}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterLibs" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="14,5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLibraries}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SortDownloads" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSortDownloads}" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SortRecent" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSortRecent}" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SortName" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSortName}" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            </DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- App update banner -->
        <Border Grid.Row="0" Background="{StaticResource Accent}" Padding="14,8"
                Visibility="{Binding AppUpdateAvailable, Converter={StaticResource BoolToVis}}">
            <Grid>
                <!-- idle: message + buttons -->
                <DockPanel Visibility="{Binding IsUpdating, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{loc:Tr Banner_WhatsNew}" Style="{StaticResource Ghost}" Click="WhatsNew_Click" Margin="0,0,8,0"/>
                        <Button Content="{loc:Tr Banner_UpdateNow}" Style="{StaticResource Update}" Click="UpdateNow_Click"/>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="{Binding AppUpdateBannerText}"/>
                </DockPanel>
                <!-- downloading: progress bar -->
                <DockPanel Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Right" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="12,0,0,0" Text="{Binding ElementName=UpdateBar, Path=Value, StringFormat='{}{0:0}%'}"/>
                    <TextBlock DockPanel.Dock="Left" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="0,0,12,0" Text="{loc:Tr Banner_Downloading}"/>
                    <ProgressBar x:Name="UpdateBar" Height="10" Minimum="0" Maximum="100" b:SmoothProgress.Target="{Binding UpdateProgress}"
                                 Background="#33FFFFFF" Foreground="White" BorderThickness="0" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Header -->
        <Grid Grid.Row="1" Margin="18,16,18,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Shoyru's Addon Suite" FontSize="24" FontWeight="Bold"/>
                <Border Background="{DynamicResource PanelAlt}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource Muted}" FontSize="14" FontWeight="SemiBold"
                               ToolTip="{loc:Tr Tip_RunningVersion}"/>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                            Visibility="{Binding IsPro, Converter={StaticResource BoolToVis}}" ToolTip="{loc:Tr Tip_ProVerified}">
                    <Grid Width="17" Height="17">
                        <Ellipse Fill="{StaticResource Accent}"/>
                        <TextBlock Text="✓" Foreground="White" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Pro" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold"
                               Margin="4,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding AddonsPath}" Foreground="{DynamicResource Muted}" FontSize="14"
                       Margin="14,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding AddonsPath}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Prominent: Get Pro (upsell, free users only) -->
                <Button x:Name="GetProButton" Content="{loc:Tr Btn_GetPro}" Style="{StaticResource Update}" Click="ManageLicense_Click" Margin="0,0,8,0"
                        Visibility="{Binding IsNotPro, Converter={StaticResource BoolToVis}}"/>
                <!-- Prominent: Pro Tools (Pro users only) -->
                <Button x:Name="ProToolsButton" Content="{loc:Tr Btn_ProTools}" Style="{StaticResource Ghost}" Click="ProTools_Click" Margin="0,0,8,0"
                        ToolTip="{loc:Tr Tip_ProTools}"
                        Visibility="{Binding IsPro, Converter={StaticResource BoolToVis}}"/>
                <!-- Settings (⚙) dropdown: declutters the header — secondary actions live here -->
                <Button x:Name="SettingsButton" Content="⚙" Style="{StaticResource Ghost}" Click="SettingsMenu_Click" Margin="0,0,8,0"
                        FontSize="18" Padding="11,4" ToolTip="{loc:Tr Tip_Settings}">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="SettingsContextMenu" Placement="Bottom"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{loc:Tr Menu_ManagePro}" Click="ManageLicense_Click"
                                      Visibility="{Binding IsPro, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{Binding ThemeToggleLabel}" Click="ToggleTheme_Click"
                                      Visibility="{Binding IsPro, Converter={StaticResource BoolToVis}}"/>
                            <Separator Visibility="{Binding IsPro, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{loc:Tr Menu_Feedback}" Click="Feedback_Click"/>
                            <MenuItem Header="{loc:Tr Menu_Replay}" Click="ReplayWalkthrough_Click"/>
                            <MenuItem Header="{loc:Tr Menu_Language}" Click="Language_Click"/>
                            <Separator/>
                            <MenuItem Header="{loc:Tr Menu_ChangeFolder}" Click="ChangeFolder_Click"/>
                            <MenuItem Header="{loc:Tr Menu_OpenFolder}" Command="{Binding OpenFolderCommand}"/>
                            <Separator/>
                            <MenuItem Header="{loc:Tr Menu_About}" Click="About_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="{loc:Tr Btn_Refresh}" Style="{StaticResource Primary}" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Filter -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="18,2,18,8">
            <TextBlock Text="{loc:Tr Lbl_Show}" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
            <Button Content="{loc:Tr Filter_All}" Style="{StaticResource FilterAll}" Command="{Binding SetFilterCommand}" CommandParameter="All" Margin="0,0,6,0"/>
            <Button Content="{loc:Tr Filter_Addons}" Style="{StaticResource FilterAddons}" Command="{Binding SetFilterCommand}" CommandParameter="Addons" Margin="0,0,6,0"/>
            <Button Content="{loc:Tr Filter_Libraries}" Style="{StaticResource FilterLibs}" Command="{Binding SetFilterCommand}" CommandParameter="Libraries"/>
        </StackPanel>

        <!-- Content: list + detail -->
        <Grid Grid.Row="3" Margin="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="390" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- LISTS -->
            <TabControl x:Name="MainTabs" Grid.Column="0" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
                <!-- Installed -->
                <TabItem Header="{loc:Tr Tab_Installed}">
                    <Grid Background="{DynamicResource Panel}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#33B4544E" BorderBrush="{StaticResource Danger}" BorderThickness="1" CornerRadius="6" Margin="12,12,12,0"
                                Visibility="{Binding AddonsFolderFound, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Margin="10,8" TextWrapping="Wrap" Foreground="{DynamicResource Text}"
                                       Text="{loc:Tr Tip_FolderNotFound}"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="12,12,12,8">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{loc:Tr Search_Label}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                <TextBox Text="{Binding InstalledSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{loc:Tr Tip_FilterInstalled}"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UpdateSummary}" FontSize="15" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                <Button x:Name="UpdateAllButton" Content="{loc:Tr Btn_UpdateAll}" Style="{StaticResource Update}" Command="{Binding UpdateAllCommand}" Margin="14,0,0,0"
                                        Visibility="{Binding AnyUpdates, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MissingDepsSummary}" Foreground="{StaticResource Danger}" FontSize="14" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Visibility="{Binding AnyMissingDeps, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding InstalledView}" SelectedItem="{Binding SelectedInstalled}" Margin="6,0,6,6">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="44" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Width="26" Height="26" b:ImageLoader.SourceUrl="{Binding ThumbUrl}" Stretch="Uniform"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:Tr Col_Addon}" Width="2*" SortMemberPath="Title">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠" Foreground="{StaticResource Danger}" FontWeight="Bold" Margin="0,0,6,0"
                                                           VerticalAlignment="Center" ToolTip="{Binding HealthTooltip}"
                                                           Visibility="{Binding HasMissingDeps, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding HealthTooltip}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr Col_Installed}" Binding="{Binding DisplayVersion}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Tr Col_Latest}" Binding="{Binding LatestVersion}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Tr Col_Released}" Binding="{Binding LastUpdated}" SortMemberPath="LastUpdateMs" Width="*"/>
                                <DataGridTextColumn Header="{loc:Tr Col_Category}" Binding="{Binding Category}" Width="*"
                                                    Visibility="{Binding Data.IsPro, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVis}}"/>
                                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="170" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,0,8,0"/>
                                                <Button Content="{loc:Tr Btn_Update}" Style="{StaticResource Update}" Padding="10,4" Margin="0,0,6,0"
                                                        Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="{loc:Tr Btn_Remove}" Style="{StaticResource Ghost}" Padding="10,4"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Browse -->
                <TabItem Header="{loc:Tr Tab_Browse}">
                    <Grid Background="{DynamicResource Panel}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" MinWidth="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- category sidebar -->
                        <DockPanel Grid.Column="0" Margin="8,12,4,8">
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Lbl_Categories}" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,6"/>
                            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- drag to resize the category panel -->
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                      Background="{DynamicResource Border}" ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Columns" Cursor="SizeWE"/>

                        <Grid Grid.Column="2" x:Name="BrowsePane">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="6,12,12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{loc:Tr Tip_BrowseSearch}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="{loc:Tr Btn_Search}" Style="{StaticResource Primary}" Command="{Binding SearchCommand}"/>
                                    <!-- AI semantic search — same box, different use. Pro-gated. -->
                                    <Button x:Name="DescribeButton" Content="{loc:Tr Btn_Describe}" Style="{StaticResource Update}" Margin="8,0,0,0"
                                            Command="{Binding DescribeCommand}"
                                            ToolTip="{loc:Tr Tip_DescribeBtn}"
                                            Visibility="{Binding IsPro, Converter={StaticResource BoolToVis}}"/>
                                    <Button x:Name="DescribeProButton" Content="{loc:Tr Btn_DescribePro}" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                            Click="ManageLicense_Click"
                                            ToolTip="{loc:Tr Tip_DescribeProBtn}"
                                            Visibility="{Binding IsNotPro, Converter={StaticResource BoolToVis}}"/>
                                    <!-- In-progress indicator: pulsing "● ● ●" while a find is running. -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                                                Visibility="{Binding IsFinding, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:Tr Tip_Searching}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                        <TextBlock Text="● ● ●" Foreground="{StaticResource Accent}" VerticalAlignment="Center" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsVisible" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.6" AutoReverse="True"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="6,0,12,8">
                                <TextBlock Text="{loc:Tr Sort_Label}" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
                                <Button Content="{loc:Tr Sort_Downloads}" Style="{StaticResource SortDownloads}" Command="{Binding SetSortCommand}" CommandParameter="Downloads" Margin="0,0,6,0"/>
                                <Button Content="{loc:Tr Sort_Recent}" Style="{StaticResource SortRecent}" Command="{Binding SetSortCommand}" CommandParameter="Recent" Margin="0,0,6,0"/>
                                <Button Content="{loc:Tr Sort_Name}" Style="{StaticResource SortName}" Command="{Binding SetSortCommand}" CommandParameter="Name"/>
                            </StackPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding BrowseView}" SelectedItem="{Binding SelectedBrowse}" Margin="6,0,6,6">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="44" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Width="26" Height="26" b:ImageLoader.SourceUrl="{Binding ThumbUrl}" Stretch="Uniform"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:Tr Col_Addon}" Width="2*" SortMemberPath="Title">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <!-- AI Describe results only: the one-line "why it matched" -->
                                                <TextBlock Text="{Binding MatchReason}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Muted}" ToolTip="{Binding MatchReason}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MatchReason}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr Col_Author}" Binding="{Binding Author}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Tr Col_Version}" Binding="{Binding Version}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Tr Col_Released}" Binding="{Binding LastUpdated}" SortMemberPath="LastUpdateMs" Width="*"/>
                                <DataGridTextColumn Header="{loc:Tr Col_Downloads}" Binding="{Binding DownloadsDisplay}" SortMemberPath="Downloads" Width="*"/>
                                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="100" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock Text="{loc:Tr Badge_Installed}" Foreground="{StaticResource Good}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="{loc:Tr Btn_Remove}" Style="{StaticResource Ghost}" Padding="10,4"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.RemoveBrowseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="{loc:Tr Btn_Install}" Style="{StaticResource Primary}" Padding="10,4"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource InvBoolToVis}}"
                                                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Shoyru's published addons -->
                <TabItem x:Name="CustomAddonsTab" Header="Browse Shoyru's Custom Addons">
                    <Grid Background="{DynamicResource Panel}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,12,12,8">
                            <TextBlock Text="Addons created by Shoyru — install them directly." Foreground="{DynamicResource Muted}" FontSize="15" VerticalAlignment="Center"/>
                            <Button Content="View on GitHub" Style="{StaticResource Ghost}" Command="{Binding OpenMyAddonsRepoCommand}" Margin="14,0,0,0"/>
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding MyAddons}" SelectedItem="{Binding SelectedMyAddon}"
                                 Background="Transparent" BorderThickness="0" Margin="6,0,6,6"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="12,9">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelAlt}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource UpdateRow}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <Button Content="Install" Style="{StaticResource Primary}" Padding="10,4" Margin="0,0,6,0"
                                                    Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.InstallMyAddonCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Update" Style="{StaticResource Update}" Padding="10,4" Margin="0,0,6,0"
                                                    Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.InstallMyAddonCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Remove" Style="{StaticResource Ghost}" Padding="10,4"
                                                    Visibility="{Binding ShowRemove, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.RemoveMyAddonCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Password gate overlay (covers the tab until unlocked for this session) -->
                        <Border Grid.RowSpan="2" Background="{DynamicResource Panel}"
                                Visibility="{Binding CustomAddonsUnlocked, Converter={StaticResource InvBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="20">
                                <TextBlock Text="&#x1F512;" FontSize="42" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                                <TextBlock Text="Shoyru's Custom Addons" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,4" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text="This tab is password-protected. Enter the access password to view and install Shoyru's custom addons."
                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,0,16"/>
                                <Button Content="Enter Password" Style="{StaticResource Primary}" HorizontalAlignment="Center" Click="UnlockCustomAddons_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- drag to resize the addon list vs the description panel -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource Border}" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" Cursor="SizeWE"/>

            <!-- DETAIL PANE -->
            <Border x:Name="DetailPane" Grid.Column="2" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Margin="8,0,0,0">
                <Grid>
                    <TextBlock Text="{loc:Tr Msg_SelectAddon}" Foreground="{DynamicResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasDetail, Converter={StaticResource InvBoolToVis}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14"
                                  Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Border Background="{DynamicResource Bg}" CornerRadius="8" Height="150" Margin="0,0,0,12"
                                    Visibility="{Binding HasDetailImage, Converter={StaticResource BoolToVis}}">
                                <Image b:ImageLoader.SourceUrl="{Binding DetailImageUrl}" Stretch="Uniform" Margin="6"
                                       Cursor="Hand" MouseLeftButtonUp="DetailImage_Click"
                                       ToolTip="Click to view full size"/>
                            </Border>
                            <TextBlock Text="{Binding DetailTitle}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DetailMeta}" Foreground="{DynamicResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,10"/>

                            <!-- actions -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="{loc:Tr Btn_Install}" Style="{StaticResource Primary}" Margin="0,0,6,0"
                                        Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding InstallCommand}" CommandParameter="{Binding DetailInstallTarget}"/>
                                <TextBlock Text="{loc:Tr Badge_Installed}" Foreground="{StaticResource Good}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding BrowseDetailInstalled, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="{loc:Tr Btn_Remove}" Style="{StaticResource Ghost}" Margin="0,0,6,0"
                                        Visibility="{Binding BrowseDetailInstalled, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding RemoveBrowseCommand}" CommandParameter="{Binding DetailInstallTarget}"/>
                                <Button Content="{loc:Tr Btn_Update}" Style="{StaticResource Update}" Margin="0,0,6,0"
                                        Visibility="{Binding DetailUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding UpdateCommand}" CommandParameter="{Binding DetailRemoveTarget}"/>
                                <Button Content="{loc:Tr Btn_Remove}" Style="{StaticResource Ghost}" Margin="0,0,6,0"
                                        Visibility="{Binding ShowManage, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding RemoveCommand}" CommandParameter="{Binding DetailRemoveTarget}"/>
                                <!-- My Addon actions -->
                                <Button Content="{loc:Tr Btn_Install}" Style="{StaticResource Primary}" Margin="0,0,6,0"
                                        Visibility="{Binding MyDetailShowInstall, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding InstallMyAddonCommand}" CommandParameter="{Binding DetailMyAddonTarget}"/>
                                <Button Content="{loc:Tr Btn_Update}" Style="{StaticResource Update}" Margin="0,0,6,0"
                                        Visibility="{Binding MyDetailUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding InstallMyAddonCommand}" CommandParameter="{Binding DetailMyAddonTarget}"/>
                                <Button Content="{loc:Tr Btn_Remove}" Style="{StaticResource Ghost}" Margin="0,0,6,0"
                                        Visibility="{Binding MyDetailShowRemove, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding RemoveMyAddonCommand}" CommandParameter="{Binding DetailMyAddonTarget}"/>
                                <Button Content="{loc:Tr Btn_EsouiPage}" Style="{StaticResource Ghost}"
                                        Visibility="{Binding HasDetailPage, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding OpenPageCommand}"/>
                            </StackPanel>

                            <!-- category assignment (Pro; installed addons only) -->
                            <StackPanel Visibility="{Binding ShowCategoryEditor, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <TextBlock Text="{loc:Tr Lbl_Category}" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{loc:Tr Btn_Set}" Style="{StaticResource Update}" Padding="12,4" Margin="6,0,0,0"
                                            Click="SetCategory_Click"/>
                                    <ComboBox x:Name="CategoryCombo" IsEditable="True" ItemsSource="{Binding KnownCategories}"
                                              Text="{Binding DetailCategoryInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Type a new category or pick an existing one, then click Set"/>
                                </DockPanel>
                                <TextBlock Text="{Binding DetailCategoryHint}"
                                           Foreground="{DynamicResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- dependencies — status list + one-click Get (free; auto-install on install is Pro) -->
                            <StackPanel Visibility="{Binding HasDependencies, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <TextBlock Text="{loc:Tr Lbl_Dependencies}" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding DetailDependencies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" Margin="0,0,8,0" FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Good}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissingSoft}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMissingRequired}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource Muted}" FontSize="13"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="{loc:Tr Btn_Install}" Style="{StaticResource Update}" Padding="10,3" FontSize="13" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.InstallDepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Name}"
                                                        Visibility="{Binding ShowGet, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>


                            <!-- dependencies note (browse mode — ESOUI API doesn't expose deps pre-install) -->
                            <StackPanel Visibility="{Binding ShowDepAutoNote, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <TextBlock Text="{loc:Tr Lbl_Dependencies}" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock Text="{loc:Tr Note_AutoDeps}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="14"/>
                            </StackPanel>

                            <!-- what's new / changelog -->
                            <StackPanel Visibility="{Binding HasChangeLog, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <TextBlock Text="{loc:Tr Lbl_WhatsNew}" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                <Border Background="{DynamicResource Bg}" CornerRadius="6" Padding="10" MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding DetailChangeLog}" TextWrapping="Wrap" Foreground="{DynamicResource Text}" FontSize="14" LineHeight="17"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <!-- description -->
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="{Binding TranslateLabel}" Command="{Binding TranslateDetailCommand}"
                                        Visibility="{Binding CanTranslateDetail, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource Ghost}" Padding="9,2" FontSize="12" VerticalAlignment="Center"
                                        ToolTip="Translate this description into your language (Pro)"/>
                                <TextBlock Text="{loc:Tr Lbl_Description}" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding DetailDescription}" TextWrapping="Wrap" Foreground="{DynamicResource Text}" LineHeight="18"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="16,8">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="14"/>
                <TextBlock Text="{loc:Tr Status_Working}" Foreground="{StaticResource Accent}" FontSize="14" HorizontalAlignment="Right"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- First-run walkthrough overlay (dims the app, spotlights the area being described) -->
        <Grid x:Name="WalkthroughHost" Grid.RowSpan="5" Panel.ZIndex="100" Background="Transparent" Visibility="Collapsed">
            <Path x:Name="WalkDim" Fill="#C4000000"/>
            <Border x:Name="WalkSpot" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="8"
                    HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>
            <Border x:Name="WalkCard" Background="{DynamicResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                    CornerRadius="10" Padding="20" Margin="40" MaxWidth="400"
                    MaxHeight="{Binding ActualHeight, ElementName=WalkthroughHost}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <!-- Nav is pinned to the bottom so the Next button is ALWAYS visible, even when a translated
                         body runs long; the body scrolls instead of pushing the buttons off-screen. -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <Button x:Name="WalkSkip" DockPanel.Dock="Left" Content="{loc:Tr Nav_Skip}" Style="{StaticResource Ghost}" Click="WalkSkip_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="WalkBack" Content="{loc:Tr Nav_Back}" Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="WalkBack_Click"/>
                            <Button x:Name="WalkNext" Content="{loc:Tr Nav_Next}" Style="{StaticResource Primary}" Click="WalkNext_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="WalkStepCounter" DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="WalkTitle" DockPanel.Dock="Top" Foreground="{DynamicResource Text}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="WalkBody" Foreground="{DynamicResource Text}" FontSize="14" TextWrapping="Wrap" LineHeight="20"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
