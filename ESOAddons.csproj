<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>EsoAddons</RootNamespace>
    <AssemblyName>Shoyrus Addon Suite</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <!-- Velopack needs to run before WPF spins up, so we provide our own Main (App.Main). -->
    <StartupObject>EsoAddons.App</StartupObject>
  </PropertyGroup>

  <!-- Business config (product IDs, checkout URLs, backend URL) — git-ignored, embedded into official
       builds only. Absent in public clones (build still works; monetization just has no values). -->
  <ItemGroup>
    <EmbeddedResource Include="appconfig.json" Condition="Exists('appconfig.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- App.xaml as Page (not ApplicationDefinition) so the SDK doesn't generate its own Main. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- The test project lives in a subfolder of this repo; keep its files out of the app's default
       globs so the app doesn't try to compile them. The test project builds separately. -->
  <ItemGroup>
    <Compile Remove="ESOAddonsTests\**\*.cs" />
    <Page Remove="ESOAddonsTests\**\*.xaml" />
    <EmbeddedResource Remove="ESOAddonsTests\**" />
    <None Remove="ESOAddonsTests\**" />
  </ItemGroup>

</Project>
